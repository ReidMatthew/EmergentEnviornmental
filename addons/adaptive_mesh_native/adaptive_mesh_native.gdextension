[configuration]

entry_symbol = "adaptive_mesh_native_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

; One release build serves the editor and games (it has no editor-only parts).
windows.debug.x86_64 = "res://addons/adaptive_mesh_native/bin/adaptive_mesh_native.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://addons/adaptive_mesh_native/bin/adaptive_mesh_native.windows.template_release.x86_64.dll"
