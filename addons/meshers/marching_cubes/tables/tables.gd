@tool
class_name MarchingCubesTables
extends RefCounted
## Marching cubes lookup tables. Shared by every mesher backend; GPU backends upload
## [member tri_table] as-is.
##
## The triangulations are Eric Lengyel's modified marching cubes from the Transvoxel
## Algorithm (transvoxel.org; data tables MIT licensed, see [TransvoxelTables]),
## converted to Paul Bourke's corner and edge numbering ("Polygonising a scalar field",
## paulbourke.net/geometry/polygonise). Lengyel's cases resolve ambiguous faces
## consistently, so meshes stay watertight, and they match his transition cells, which
## join chunks of different resolutions (see [MesherTransition]).
##
## Corner numbering (offset from the cell's lowest sample):
##   0 (0,0,0)  1 (1,0,0)  2 (1,0,1)  3 (0,0,1)
##   4 (0,1,0)  5 (1,1,0)  6 (1,1,1)  7 (0,1,1)
## A corner sets bit [code]1 << corner[/code] of the case index when its value is below the iso level.

## The tables wind triangles the opposite way to Godot's clockwise front faces, so every
## backend swaps the last two indices of each triangle.
const FLIP_WINDING := true

const CORNERS: Array[Vector3i] = [
	Vector3i(0, 0, 0), Vector3i(1, 0, 0), Vector3i(1, 0, 1), Vector3i(0, 0, 1),
	Vector3i(0, 1, 0), Vector3i(1, 1, 0), Vector3i(1, 1, 1), Vector3i(0, 1, 1),
]

## Each edge as its lower corner offset plus an axis (0 = x, 1 = y, 2 = z). The other end is
## one step along that axis. Describing edges this way gives every grid edge a unique id,
## which is how neighbouring cells share vertices.
const EDGE_ORIGIN: Array[Vector3i] = [
	Vector3i(0, 0, 0), Vector3i(1, 0, 0), Vector3i(0, 0, 1), Vector3i(0, 0, 0),
	Vector3i(0, 1, 0), Vector3i(1, 1, 0), Vector3i(0, 1, 1), Vector3i(0, 1, 0),
	Vector3i(0, 0, 0), Vector3i(1, 0, 0), Vector3i(1, 0, 1), Vector3i(0, 0, 1),
]
const EDGE_AXIS: Array[int] = [0, 2, 0, 2, 0, 2, 0, 2, 1, 1, 1, 1]

