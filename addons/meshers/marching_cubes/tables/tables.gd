## Bitmask of edges crossed by the surface, per case. Derived from [member tri_table].
static var edge_mask := _build_edge_mask()


static func _build_edge_mask() -> PackedInt32Array:
	var masks := PackedInt32Array()
	masks.resize(256)
	for case_index in 256:
		var mask := 0
		var t := case_index * 16
		while tri_table[t] != -1:
			mask |= 1 << tri_table[t]
			t += 1
		masks[case_index] = mask
	return masks
